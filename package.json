{
  "name": "pi-redteam-minimal",
  "version": "0.1.0",
  "private": true,
  "description": "A scope-aware red-team workflow for Pi and scanlens",
  "keywords": ["pi-package", "red-team", "scanlens"],
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "tsc --noEmit"
  },
  "pi": {
    "extensions": ["./extensions/redteam.ts"],
    "skills": ["./skills/redteam"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
